# Development default. Supported values: groq, bedrock
LLM_PROVIDER=groq

# Groq development model
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional AWS Bedrock configuration for the hackathon environment
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
